@using Progress.Sitefinity.AspNetCore.Widgets.Models.Image
@using Progress.Sitefinity.RestSdk.Dto;
@using Progress.Sitefinity.AspNetCore.Mvc.Rendering;

@model Progress.Sitefinity.AspNetCore.Widgets.Models.ContentList.ContentListViewModel

<ul class="card__list swiper-wrapper">
    @foreach(var item in Model.Items)
    {
        var title = item.GetValue<string>("Title");
        var content = item.GetValue<string>("Content");
        var image = Model.GetFirstRelatedMedia(item, "Image");

        <li class="card__item swiper-slide">
            <div class="card__item-wrap">
                <div class="card__info">
                    <div class="card__wrap-img">
                        <picture class="aspect-ratio" style="--aspect-ratio: 87/87; ">
                            <img loading="lazy" width="87" height="87" src="@image.Url" alt="picture">
                        </picture>
                    </div>
                    <span class="card__subtitle">@title</span>

                </div>
                <p class="card__text">@content</p>
            </div>
        </li>
    }
</ul>
