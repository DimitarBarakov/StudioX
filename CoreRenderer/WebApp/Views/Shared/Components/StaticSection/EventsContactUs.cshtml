@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Progress.Sitefinity.AspNetCore

@using Progress.Sitefinity.AspNetCore.ViewComponents
@using WebApp.ViewModels.StaticSection

@model StaticSectionViewModel

<section class="strip strip--color mt-xl">
    <div class="wrapper">
        <div class="strip__wrapper">
            <div class="strip__box">

                <div class="container" data-sfcontainer container-context="@this.Model.Context.ContainerContext("Title", "Title")"></div>

                <div class="strip__text container" data-sfcontainer container-context="@this.Model.Context.ContainerContext("Text", "Text")">
                    
                </div>
                <div data-sfcontainer container-context="@this.Model.Context.ContainerContext("Button", "Button")">
                </div>
                @* <a class="button button--primary-white" href="#">Contact us</a> *@

            </div>
        </div>
    </div>
</section>
